  94          /* 掃描 Keypad */
  95          unsigned char Keypad_Scan(void)
  96          {
  97   1          static unsigned char keymap[4][4] =
  98   1          {
  99   1              {'1','2','3','A'},
 100   1              {'4','5','6','B'},
 101   1              {'7','8','9','C'},
 102   1              {'*','0','#','D'}
 103   1          };
 104   1      
 105   1          unsigned char row,col;
 106   1      
 107   1          KR0 = KR1 = KR2 = KR3 = 1;
 108   1      
 109   1          for(col=0; col<4; col++)
 110   1          {
 111   2              KC0 = KC1 = KC2 = KC3 = 1;
 112   2      
 113   2              switch(col)
 114   2              {
 115   3                  case 0: KC0 = 0; break;
 116   3                  case 1: KC1 = 0; break;
 117   3                  case 2: KC2 = 0; break;
C51 COMPILER V6.11  05                                                                     03/09/2026 13:19:55 PAGE 3   

 118   3                  case 3: KC3 = 0; break;
 119   3              }
 120   2      
 121   2              if(KR0==0){ row=0; goto pressed; }
 122   2              if(KR1==0){ row=1; goto pressed; }
 123   2              if(KR2==0){ row=2; goto pressed; }
 124   2              if(KR3==0){ row=3; goto pressed; }
 125   2          }
 126   1      
 127   1          return 0;
 128   1      
 129   1      pressed:
 130   1          Delay5ms();
 131   1          Keypad_WaitRelease();
 132   1          return keymap[row][col];
 133   1      }
