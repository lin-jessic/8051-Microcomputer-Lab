 130   3                  case 0: KC0 = 0; break;
 131   3                  case 1: KC1 = 0; break;
 132   3                  case 2: KC2 = 0; break;
 133   3                  case 3: KC3 = 0; break;
 134   3              }
 135   2      
 136   2              if(KR0==0){ row=0; goto pressed; }
 137   2              if(KR1==0){ row=1; goto pressed; }
 138   2              if(KR2==0){ row=2; goto pressed; }
 139   2              if(KR3==0){ row=3; goto pressed; }
 140   2          }
 141   1      
 142   1          return 0;
 143   1      
 144   1      pressed:
 145   1          Delay5ms();
 146   1          Keypad_WaitRelease();
 147   1          return keymap[row][col];
 148   1      }
